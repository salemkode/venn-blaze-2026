{
  "name": "venn",
  "version": "0.1.0",
  "main": "./index",
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@expo/ui": "58.0.29",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@wizardconnect/core": "0.2.10",
    "@wizardconnect/dapp": "0.2.7",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-device": "58.0.5",
    "expo-font": "58.0.12",
    "expo-glass-effect": "58.0.5",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-symbols": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.1.0",
    "lucide-react-native": "1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keychain": "10.0.0",
    "react-native-libauth": "file:./modules/libauth-native",
    "react-native-qrcode-svg": "6.3.15",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-xo": "file:vendor/react-native-xo-0.2.2-rc.4.tgz",
    "text-encoding": "0.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "cashc": "0.14.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "patch-package": "8.0.1",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8097",
    "ios": "expo run:ios --port 8097",
    "android": "expo run:android --port 8097",
    "web": "expo start --web --port 8099",
    "build:web": "expo export --platform web && node scripts/web-phone-frame.mjs dist",
    "build:landing": "node scripts/build-landing.mjs",
    "build:blaze": "npm run build:web && node scripts/build-landing.mjs --with-wallet",
    "demo:blaze": "vitest run tests/venn/plan.test.ts tests/venn/spend.test.ts --reporter=verbose --hideSkippedTests -t \"an acceptance signs this plan and this seat only|waits for everyone, then creates a Venn|member spends within budget|over budget fails\"",
    "setup:native": "expo prebuild --no-install",
    "test": "vitest run",
    "test:native-core": "npm --prefix modules/libauth-native run test:host",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "compile:contract": "node scripts/compile-contract.mjs",
    "postinstall": "patch-package --error-on-fail"
  },
  "private": true,
  "license": "MIT",
  "description": "Venn: a Bitcoin Cash wallet for iOS, Android and web.",
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "fsevents": true
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    },
    "react-native-xo": {
      "zod": "$zod"
    }
  }
}
